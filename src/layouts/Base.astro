---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}
const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  type = 'website',
} = Astro.props;

const base = (Astro.site ? Astro.site.toString() : site.url).replace(/\/$/, '');
const path = Astro.url.pathname === '/' ? '' : Astro.url.pathname;
const canonical = path ? `${base}${path}` : base;
const ogImage = `${base}/og.png`;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://sourceforge.net" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.name,
      url: site.url,
      description: site.description,
      sameAs: [site.github, site.telegram],
    })}></script>
  </head>

  <body class="flex min-h-full flex-col bg-white">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <div class="pointer-events-none fixed inset-x-0 bottom-4 z-40 sm:bottom-6 lg:bottom-8">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <button
          id="back-to-top"
          type="button"
          aria-label="Back to top"
          class="back-to-top ml-auto grid h-11 w-11 place-items-center rounded-full border border-zinc-200 bg-white/90 text-zinc-600 shadow-lg backdrop-blur hover:border-brand-200 hover:text-brand-600 hover:shadow-xl"
        >
          <Icon name="chevron-up" size={20} />
        </button>
      </div>
    </div>

    <script>
      const header = document.getElementById('site-header');
      const toTop = document.getElementById('back-to-top');
      const onScroll = () => {
        const y = window.scrollY > 8;
        if (header) {
          header.classList.toggle('shadow-sm', y);
          header.classList.toggle('border-zinc-200', y);
          header.classList.toggle('bg-white/85', y);
        }
        toTop?.classList.toggle('is-visible', window.scrollY > 480);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      toTop?.addEventListener('click', () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });

      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconMenu = document.querySelector('#menu-toggle .icon-menu');
      const iconX = document.querySelector('#menu-toggle .icon-x');
      let open = false;
      const setOpen = (v: boolean) => {
        open = v;
        menu?.classList.toggle('hidden', !v);
        toggle?.setAttribute('aria-expanded', String(v));
        iconMenu?.classList.toggle('hidden', v);
        iconX?.classList.toggle('hidden', !v);
        document.body.style.overflow = v ? 'hidden' : '';
      };
      toggle?.addEventListener('click', () => setOpen(!open));
      menu?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && open) setOpen(false);
      });

      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
