---
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import StatusBadge from './StatusBadge.astro';
import type { Device } from '@/data/devices';

interface Props {
  device: Device;
}
const { device } = Astro.props;
const latest = device.builds[0];
---

<a
  href={`/devices/${device.code}`}
  data-status={device.status}
  data-search={`${device.name} ${device.code} ${device.maintainer.name}`.toLowerCase()}
  class="device-card group relative flex flex-col rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-600/5"
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="grid h-12 w-12 place-items-center rounded-xl text-brand-600 ring-1 ring-brand-100"
      style="background-image:linear-gradient(135deg,#eef2ff,#f5f3ff);"
    >
      <Icon name="smartphone" size={24} />
    </span>
    <StatusBadge status={device.status} />
  </div>

  <h3 class="mt-4 text-base font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-brand-700">
    {device.name}
  </h3>
  <span class="mt-1.5 inline-flex w-fit items-center rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-500">
    {device.code}
  </span>

  <div class="mt-4 flex items-center gap-2 border-t border-zinc-100 pt-4">
    <Avatar name={device.maintainer.name} size={28} />
    <span class="truncate text-xs font-medium text-zinc-500">{device.maintainer.name}</span>
  </div>

  <div class="mt-3 flex items-center justify-between text-xs">
    {
      latest ? (
        <span class="inline-flex items-center gap-1.5 text-zinc-500">
          <Icon name="package" size={14} class="text-zinc-400" />
          <span class="font-medium text-zinc-600">{latest.name}</span>
          <span class="text-zinc-400">·</span>
          <span>{latest.size}</span>
        </span>
      ) : (
        <span class="text-zinc-400">Awaiting first build</span>
      )
    }
    <span class="inline-flex items-center gap-1 font-semibold text-brand-600 transition-transform duration-300 group-hover:translate-x-0.5">
      Builds
      <Icon name="arrow-right" size={14} />
    </span>
  </div>
</a>
