---
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import type { Device } from '@/data/devices';

interface Props {
  device: Device;
}
const { device } = Astro.props;
---

<a
  href={`/devices/${device.code}`}
  data-status={device.status}
  data-search={`${device.name} ${device.code} ${device.maintainer.name}`.toLowerCase()}
  class="device-card group relative flex flex-col rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-600/5"
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="grid h-11 w-11 place-items-center rounded-xl text-brand-600 ring-1 ring-brand-100"
      style="background-image:linear-gradient(135deg,var(--color-brand-50),#ffffff);"
    >
      <Icon name="smartphone" size={22} />
    </span>
    <StatusBadge status={device.status} />
  </div>

  <h3 class="mt-4 text-base font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-brand-700">
    {device.name}
  </h3>
  <span class="mt-1.5 inline-flex w-fit items-center rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-500">
    {device.code}
  </span>

  <span class="mt-auto inline-flex items-center gap-1 pt-4 text-xs font-semibold text-zinc-400 transition-colors group-hover:text-brand-600">
    View builds
    <Icon name="arrow-right" size={13} class="transition-transform duration-300 group-hover:translate-x-0.5" />
  </span>
</a>
