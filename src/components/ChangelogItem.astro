---
import Icon from './Icon.astro';
import type { Changelog } from '@/data/changelogs';

interface Props {
  entry: Changelog;
  index: number;
}
const { entry, index } = Astro.props;
const VISIBLE = 6;
const visible = entry.whatsNew.slice(0, VISIBLE);
const rest = entry.whatsNew.slice(VISIBLE);
const isLatest = index === 0;
---

<article
  class:list={[
    'relative rounded-2xl border bg-white p-6 shadow-sm sm:p-8',
    isLatest ? 'border-brand-200 ring-1 ring-brand-100' : 'border-zinc-200',
  ]}
>
  {isLatest && (
    <span class="absolute -top-2.5 right-6 rounded-full bg-brand-600 px-3 py-0.5 text-xs font-semibold text-white shadow-sm">
      Latest
    </span>
  )}

  <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
    <h3 class="text-2xl font-bold tracking-tight text-zinc-900">
      {entry.version} <span class="text-brand-600">{entry.codename}</span>
    </h3>
    <span class="rounded-full border border-brand-100 bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">
      {entry.android}
    </span>
  </div>

  <div class="mt-2 flex items-center gap-2 text-sm text-zinc-500">
    <Icon name="clock" size={15} class="text-zinc-400" />
    {entry.date}
  </div>

  <p class="mt-4 max-w-3xl leading-relaxed text-zinc-600">{entry.description}</p>

  <div class="mt-6">
    <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">What's New</h4>
    <ul class="mt-3 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
      {visible.map((line) => (
        <li class="flex items-start gap-2.5 text-sm text-zinc-700">
          <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-500" />
          <span>{line}</span>
        </li>
      ))}
    </ul>

    {rest.length > 0 && (
      <details class="group mt-4">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-lg px-1 text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700 [&::-webkit-details-marker]:hidden">
          <Icon name="chevron-down" size={16} class="transition-transform group-open:rotate-180" />
          Show all {entry.whatsNew.length} changes
        </summary>
        <ul class="mt-4 grid gap-x-8 gap-y-2.5 border-t border-dashed border-zinc-200 pt-4 sm:grid-cols-2">
          {rest.map((line) => (
            <li class="flex items-start gap-2.5 text-sm text-zinc-700">
              <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-400" />
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</article>
