---
import Icon from './Icon.astro';
import type { DeviceBuild } from '@/data/devices';

interface Props {
  build: DeviceBuild;
  isLatest?: boolean;
}
const { build, isLatest = false } = Astro.props;
const isGapps = build.type === 'GAPPS';
---

<article
  class:list={[
    'relative rounded-2xl border bg-white p-5 shadow-sm sm:p-6',
    isLatest ? 'border-brand-200 ring-1 ring-brand-100' : 'border-zinc-200',
  ]}
>
  {isLatest && (
    <span class="absolute -top-2.5 right-5 rounded-full bg-brand-600 px-2.5 py-0.5 text-[11px] font-semibold text-white shadow-sm">
      Latest
    </span>
  )}

  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <div class="flex items-center gap-3">
      <span
        class:list={[
          'grid h-10 w-10 place-items-center rounded-xl ring-1',
          isGapps ? 'bg-amber-50 text-amber-600 ring-amber-100' : 'bg-emerald-50 text-emerald-600 ring-emerald-100',
        ]}
      >
        <Icon name={isGapps ? 'cloud' : 'leaf'} size={20} />
      </span>
      <div>
        <h3 class="text-base font-semibold text-zinc-900">{build.name}</h3>
        <p class:list={['text-xs font-semibold', isGapps ? 'text-amber-600' : 'text-emerald-600']}>
          {isGapps ? 'GApps' : 'Vanilla'}
        </p>
      </div>
    </div>
    <div class="flex items-center gap-4 text-sm text-zinc-500">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="package" size={15} class="text-zinc-400" />
        {build.size}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="clock" size={15} class="text-zinc-400" />
        {build.date}
      </span>
    </div>
  </div>

  {
    build.whatsNew && build.whatsNew.length > 0 && (
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {build.whatsNew.slice(0, 6).map((line) => (
          <li class="flex items-start gap-2 text-sm text-zinc-600">
            <Icon name="check" size={15} class="mt-0.5 shrink-0 text-brand-500" />
            <span>{line}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-5 flex flex-col gap-2.5 border-t border-zinc-100 pt-4 sm:flex-row sm:justify-end">
    <a
      href={build.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 active:scale-[0.98] sm:w-auto"
    >
      <Icon name="download" size={16} />
      Download
    </a>
  </div>
</article>
