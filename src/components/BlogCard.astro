---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const data = post.data;

const words = post.body?.trim().split(/\s+/).length ?? 0;
const readTime = Math.max(1, Math.ceil(words / 200));
const date = data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<a
  href={`/blog/${post.id}`}
  data-tags={data.tags.join(' ').toLowerCase()}
  class="blog-card group block rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-600/5 sm:p-7"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-zinc-400">
    <span class="inline-flex items-center gap-1.5 font-medium">
      <Icon name="clock" size={13} />
      {date}
    </span>
    <span aria-hidden="true">·</span>
    <span>{readTime} min read</span>
    {data.device && (
      <>
        <span aria-hidden="true">·</span>
        <span class="font-medium text-brand-600">{data.device}</span>
      </>
    )}
  </div>

  <h3 class="mt-3 text-xl font-bold leading-snug tracking-tight text-zinc-900 transition-colors duration-300 group-hover:text-brand-700 sm:text-2xl">
    {data.title}
  </h3>
  <p class="mt-2 leading-relaxed text-zinc-500">{data.description}</p>

  <div class="mt-4 flex items-center justify-between gap-4">
    <div class="flex flex-wrap gap-1.5">
      {
        data.tags.map((t) => (
          <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-500 transition-colors duration-300 group-hover:bg-brand-50 group-hover:text-brand-700">
            {t}
          </span>
        ))
      }
    </div>
    <span class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-zinc-400 transition-colors duration-300 group-hover:text-brand-600">
      Read
      <Icon name="arrow-right" size={15} class="transition-transform duration-300 group-hover:translate-x-1" />
    </span>
  </div>
</a>
