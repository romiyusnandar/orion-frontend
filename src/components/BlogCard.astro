---
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  index: number;
}
const { post, index } = Astro.props;
const data = post.data;

const tag = (data.tags[0] ?? 'post').toLowerCase();
const banner: Record<string, string> = {
  tutorial: 'linear-gradient(135deg,#6366f1 0%,#8b5cf6 100%)',
  installation: 'linear-gradient(135deg,#6366f1 0%,#8b5cf6 100%)',
  announcement: 'linear-gradient(135deg,#0ea5e9 0%,#06b6d4 100%)',
  welcome: 'linear-gradient(135deg,#0ea5e9 0%,#06b6d4 100%)',
  news: 'linear-gradient(135deg,#f59e0b 0%,#f97316 100%)',
};
const gradient = banner[tag] ?? `linear-gradient(135deg,${['#6366f1', '#0ea5e9', '#8b5cf6'][index % 3]} 0%,${['#4338ca', '#2563eb', '#7c3aed'][index % 3]} 100%)`;
const bigIcon = tag === 'announcement' || tag === 'welcome' ? 'sparkles' : 'rocket';

const date = data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<a
  href={`/blog/${post.id}`}
  data-tags={data.tags.join(' ').toLowerCase()}
  class="blog-card group flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-600/5"
>
  <div class="relative h-32 overflow-hidden" style={`background-image:${gradient};`}>
    <div class="absolute inset-0 bg-dots opacity-30"></div>
    <span class="absolute right-4 bottom-3 text-white/40 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6">
      <Icon name={bigIcon} size={64} />
    </span>
    <div class="absolute left-4 top-4 flex items-center gap-2">
      <span class="rounded-full bg-white/20 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-sm">{data.tags[0]}</span>
      {data.device && <span class="rounded-full bg-black/20 px-2.5 py-1 text-xs font-medium text-white backdrop-blur-sm">{data.device}</span>}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap gap-1.5">
      {
        data.tags.slice(1).map((t) => (
          <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-500">{t}</span>
        ))
      }
    </div>
    <h3 class="mt-3 text-lg font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-brand-700">{data.title}</h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-500">{data.description}</p>

    <div class="mt-auto flex items-center gap-2.5 border-t border-zinc-100 pt-4">
      <Avatar name={data.author} size={30} />
      <div class="min-w-0 text-xs">
        <p class="truncate font-semibold text-zinc-700">{data.author}</p>
        <p class="text-zinc-400">{date}</p>
      </div>
    </div>
  </div>
</a>
