---
interface Props {
  size?: number;
  withWord?: boolean;
  class?: string;
}
const { size = 34, withWord = true, class: className = '' } = Astro.props;
const star = Math.round(size * 0.6);
---

<span class={`inline-flex items-center gap-2.5 select-none ${className}`}>
  <span
    class="inline-flex items-center justify-center rounded-xl shadow-sm ring-1 ring-black/5"
    style={`background-image: linear-gradient(135deg,#6366f1 0%,#4f46e5 45%,#4338ca 100%); width: ${size}px; height: ${size}px;`}
  >
    <svg viewBox="0 0 24 24" width={star} height={star} fill="white" aria-hidden="true">
      <path d="M12 2.5 C12.7 8.2 16.2 11.7 21.5 12 C16.2 12.7 12.7 16.2 12 21.5 C11.7 16.2 8.2 12.7 2.5 12 C8.2 11.7 11.7 8.2 12 2.5 Z" />
    </svg>
  </span>
  {withWord && (
    <span class="text-[1.15rem] font-bold tracking-tight text-zinc-900 leading-none">
      Orion<span class="text-brand-600">OS</span>
    </span>
  )}
</span>
