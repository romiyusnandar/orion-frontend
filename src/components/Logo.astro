---
interface Props {
  size?: number;
  withWord?: boolean;
  class?: string;
}
const { size = 34, withWord = true, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 select-none ${className}`}>
  <img
    src="/orion-lg.png"
    alt="Orion OS logo"
    width={size}
    height={size}
    style={`width:${size}px;height:${size}px;`}
    loading="eager"
    decoding="async"
  />
  {withWord && (
    <span class="text-[1.15rem] font-bold tracking-tight text-zinc-900 leading-none">
      Orion<span class="text-brand-600">OS</span>
    </span>
  )}
</span>
