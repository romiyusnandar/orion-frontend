---
import { avatarColor, initials } from '@/data/developers';
interface Props {
  name: string;
  size?: number;
  ring?: boolean;
  src?: string;
}
const { name, size = 44, ring = false, src } = Astro.props;
const color = avatarColor(name);
const fs = Math.max(11, Math.round(size * 0.36));
const ringCls = ring ? 'ring-2 ring-white' : '';
---

<span class={`relative inline-block shrink-0 overflow-hidden rounded-full ${ringCls}`} style={`width:${size}px;height:${size}px;`}>
  <span
    class="absolute inset-0 grid place-items-center rounded-full font-semibold text-white"
    style={`background-color:${color};font-size:${fs}px;letter-spacing:0.02em;`}
    role="img"
    aria-label={name}
  >
    {initials(name)}
  </span>
  {
    src && (
      <img
        src={src}
        alt={name}
        width={size}
        height={size}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class="avatar-img absolute inset-0 h-full w-full object-cover"
      />
    )
  }
</span>
