---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '@/data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-white/70 backdrop-blur-md transition-all duration-300"
>
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8" aria-label="Primary">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="shrink-0" aria-label="Orion OS home">
        <Logo size={34} />
      </a>

      <div class="hidden items-center gap-1 md:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3.5 py-2 text-sm font-medium transition-colors',
                isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="hidden items-center gap-2 md:flex">
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-9 w-9 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900"
          aria-label="GitHub"
        >
          <Icon name="github" size={19} />
        </a>
        <a
          href="/devices"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 active:scale-[0.98]"
        >
          <Icon name="download" size={16} />
          Download
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="relative grid h-10 w-10 place-items-center overflow-hidden rounded-lg text-zinc-700 transition-colors hover:bg-zinc-100 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon icon-menu is-shown absolute inset-0 grid place-items-center"><Icon name="menu" size={22} /></span>
        <span class="menu-icon icon-x is-hidden absolute inset-0 grid place-items-center"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu absolute inset-x-0 top-full border-b border-zinc-200 bg-white/95 shadow-xl backdrop-blur-md md:hidden">
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-3 sm:px-6" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block rounded-lg px-3.5 py-2.5 text-sm font-medium transition-colors',
              isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-zinc-700 hover:bg-zinc-100',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/devices"
        class="mt-2 flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
      >
        <Icon name="download" size={16} />
        Download Now
      </a>
    </nav>
  </div>
</header>
