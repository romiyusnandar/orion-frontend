---
// Features Component - Bento Grid Layout
---

<section class="features-section">
    <div class="container">
        <!-- Section Header -->
        <div class="features-header">
            <h2 class="features-title">Built for Excellence</h2>
            <p class="features-subtitle">
                Every feature designed to give you the best Android experience
            </p>
        </div>

        <!-- Bento Grid -->
        <div class="bento-grid">
            <!-- Feature 1: High Performance (Large Card) -->
            <div class="feature-card feature-large">
                <div class="feature-icon-wrapper">
                    <svg
                        class="feature-icon"
                        width="48"
                        height="48"
                        viewBox="0 0 48 48"
                        fill="none"
                    >
                        <!-- Rocket/Speed Icon -->
                        <path
                            d="M24 4L28 12L36 8L32 16L40 20L32 24L36 32L28 28L24 36L20 28L12 32L16 24L8 20L16 16L12 8L20 12L24 4Z"
                            fill="currentColor"
                            opacity="0.8"></path>
                        <circle cx="24" cy="24" r="4" fill="white"></circle>
                        <!-- Speed lines -->
                        <path
                            d="M4 24H12M4 18H10M4 30H10"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            opacity="0.5"></path>
                    </svg>
                </div>
                <h3 class="feature-title">High Performance</h3>
                <p class="feature-description">
                    Lightning-fast performance with optimized code and minimal
                    bloat. Experience smooth multitasking and instant app
                    launches.
                </p>
            </div>

            <!-- Feature 2: Minimalist Design -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg
                        class="feature-icon"
                        width="40"
                        height="40"
                        viewBox="0 0 40 40"
                        fill="none"
                    >
                        <!-- Minimalist Layout Icon -->
                        <rect
                            x="6"
                            y="6"
                            width="28"
                            height="28"
                            rx="2"
                            stroke="currentColor"
                            stroke-width="2"
                            fill="none"></rect>
                        <line
                            x1="6"
                            y1="14"
                            x2="34"
                            y2="14"
                            stroke="currentColor"
                            stroke-width="2"></line>
                        <rect
                            x="10"
                            y="18"
                            width="8"
                            height="8"
                            rx="1"
                            fill="currentColor"
                            opacity="0.8"></rect>
                        <rect
                            x="22"
                            y="18"
                            width="8"
                            height="8"
                            rx="1"
                            fill="currentColor"
                            opacity="0.8"></rect>
                        <rect
                            x="10"
                            y="28"
                            width="20"
                            height="2"
                            rx="1"
                            fill="currentColor"
                            opacity="0.5"></rect>
                    </svg>
                </div>
                <h3 class="feature-title">Minimalist Design</h3>
                <p class="feature-description">
                    Clean, distraction-free interface that puts content first.
                    Beautiful simplicity meets powerful functionality.
                </p>
            </div>

            <!-- Feature 3: Feature Rich -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg
                        class="feature-icon"
                        width="40"
                        height="40"
                        viewBox="0 0 40 40"
                        fill="none"
                    >
                        <!-- Grid/Apps Icon -->
                        <rect
                            x="6"
                            y="6"
                            width="10"
                            height="10"
                            rx="2"
                            fill="currentColor"
                            opacity="0.8"></rect>
                        <rect
                            x="20"
                            y="6"
                            width="10"
                            height="10"
                            rx="2"
                            fill="currentColor"
                            opacity="0.8"></rect>
                        <rect
                            x="6"
                            y="20"
                            width="10"
                            height="10"
                            rx="2"
                            fill="currentColor"
                            opacity="0.8"></rect>
                        <rect
                            x="20"
                            y="20"
                            width="10"
                            height="10"
                            rx="2"
                            fill="currentColor"
                            opacity="0.8"></rect>
                        <!-- Plus sign overlay -->
                        <circle cx="32" cy="32" r="6" fill="currentColor"
                        ></circle>
                        <path
                            d="M32 29V35M29 32H35"
                            stroke="white"
                            stroke-width="2"
                            stroke-linecap="round"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Feature Rich</h3>
                <p class="feature-description">
                    Packed with powerful features and customization options.
                    Everything you need, nothing you don't.
                </p>
            </div>

            <!-- Feature 4: Active Community -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg
                        class="feature-icon"
                        width="40"
                        height="40"
                        viewBox="0 0 40 40"
                        fill="none"
                    >
                        <!-- Community/People Icon -->
                        <circle
                            cx="20"
                            cy="12"
                            r="4"
                            fill="currentColor"
                            opacity="0.8"></circle>
                        <path
                            d="M12 28C12 24 15 22 20 22C25 22 28 24 28 28"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            fill="none"></path>
                        <!-- Additional people -->
                        <circle
                            cx="10"
                            cy="14"
                            r="3"
                            fill="currentColor"
                            opacity="0.5"></circle>
                        <circle
                            cx="30"
                            cy="14"
                            r="3"
                            fill="currentColor"
                            opacity="0.5"></circle>
                        <path
                            d="M4 30C4 27 6 26 10 26M36 30C36 27 34 26 30 26"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            opacity="0.5"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Active Community</h3>
                <p class="feature-description">
                    Join thousands of users and developers. Get support, share
                    mods, and shape the future together.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* ============================================
     FEATURES SECTION
     ============================================ */
    .features-section {
        padding: var(--spacing-section-y-mobile) 0;
        background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
    }

    @media (min-width: 768px) {
        .features-section {
            padding: var(--spacing-section-y) 0;
        }
    }

    /* ============================================
     SECTION HEADER
     ============================================ */
    .features-header {
        text-align: center;
        margin-bottom: 3rem;
        animation: fadeIn 0.8s ease-out;
    }

    .features-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        color: var(--color-text-primary);
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }

    .features-subtitle {
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: var(--color-text-secondary);
        max-width: 600px;
        margin: 0 auto;
    }

    /* ============================================
     BENTO GRID LAYOUT
     ============================================ */
    .bento-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        animation: fadeInUp 1s ease-out 0.2s both;
    }

    @media (min-width: 768px) {
        .bento-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
        }
    }

    @media (min-width: 1024px) {
        .bento-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* ============================================
     FEATURE CARDS
     ============================================ */
    .feature-card {
        background: #f8f9fa;
        border-radius: var(--radius-2xl);
        padding: 2rem;
        transition: all var(--transition-base);
        border: 1px solid rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .feature-card:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow:
            0 20px 40px rgba(0, 0, 0, 0.08),
            0 0 0 1px rgba(0, 0, 0, 0.02);
        background: #ffffff;
    }

    /* Large Card (High Performance) */
    .feature-large {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    @media (min-width: 768px) {
        .feature-large {
            grid-column: span 2;
        }
    }

    @media (min-width: 1024px) {
        .feature-large {
            grid-column: span 2;
            grid-row: span 2;
        }
    }

    .feature-large:hover {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
    }

    /* ============================================
     FEATURE CONTENT
     ============================================ */
    .feature-icon-wrapper {
        width: fit-content;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.8);
        border-radius: var(--radius-xl);
        transition: all var(--transition-base);
    }

    .feature-card:hover .feature-icon-wrapper {
        background: rgba(255, 255, 255, 1);
        transform: scale(1.1);
    }

    .feature-icon {
        color: var(--color-orion);
        display: block;
    }

    .feature-large .feature-icon {
        width: 56px;
        height: 56px;
    }

    .feature-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
        letter-spacing: -0.01em;
    }

    .feature-large .feature-title {
        font-size: 2rem;
    }

    .feature-description {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .feature-large .feature-description {
        font-size: 1.125rem;
    }

    /* ============================================
     STATS (Performance Card Only)
     ============================================ */
    .feature-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        margin-top: auto;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-orion);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* ============================================
     ANIMATIONS
     ============================================ */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ============================================
     REDUCED MOTION
     ============================================ */
    @media (prefers-reduced-motion: reduce) {
        .features-header,
        .bento-grid,
        .feature-card {
            animation: none;
        }

        .feature-card:hover {
            transform: none;
        }

        .feature-card:hover .feature-icon-wrapper {
            transform: none;
        }
    }
</style>
