---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
const wrap = align === 'center' ? 'mx-auto items-center text-center' : 'items-start text-left';
---

<div class={`flex max-w-2xl flex-col ${wrap}`}>
  {eyebrow && <span class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-600">{eyebrow}</span>}
  <h2 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg leading-relaxed text-zinc-500">{subtitle}</p>}
</div>
