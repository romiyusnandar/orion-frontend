---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import BlogCard from '@/components/BlogCard.astro';
import Icon from '@/components/Icon.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).map((t) => t.toLowerCase());
---

<Base title="Blog — Orion OS" description="The latest updates, in-depth installation tutorials, and news from the Orion OS ecosystem.">
  <section class="border-b border-zinc-100 bg-zinc-50/60">
    <div class="mx-auto max-w-5xl px-4 pt-16 pb-10 sm:px-6 lg:px-8">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Blog</span>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl">From the blog</h1>
      <p class="mt-4 max-w-2xl text-lg text-zinc-500">
        Updates, step-by-step installation guides, and news from the Orion OS ecosystem.
      </p>

      {
        tags.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center gap-1.5">
            <button data-tag="all" class="filter-tab is-active rounded-full border border-transparent bg-brand-600 px-4 py-1.5 text-sm font-semibold text-white">
              All
            </button>
            {tags.map((t) => (
              <button data-tag={t} class="filter-tab rounded-full border border-zinc-200 bg-white px-4 py-1.5 text-sm font-semibold text-zinc-600">
                {t}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div id="blog-grid" class="grid gap-6 sm:grid-cols-2">
      {posts.map((post, i) => <BlogCard post={post} index={i} />)}
    </div>

    <div id="blog-empty" class="hidden rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/50 px-6 py-16 text-center">
      <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-white text-zinc-400 ring-1 ring-zinc-200">
        <Icon name="sparkles" size={26} />
      </span>
      <h3 class="mt-4 text-lg font-semibold text-zinc-800">No articles here yet</h3>
      <p class="mt-1 text-sm text-zinc-500">Nothing matches this tag. Try another one.</p>
    </div>
  </section>

  <script>
    const empty = document.getElementById('blog-empty') as HTMLDivElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-tab'));
    let tag = 'all';

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const match = tag === 'all' || (card.dataset.tags ?? '').includes(tag);
        card.classList.toggle('hidden', !match);
        if (match) shown++;
      }
      empty?.classList.toggle('hidden', shown !== 0);
    };

    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tag = t.dataset.tag ?? 'all';
        tabs.forEach((x) => x.classList.toggle('is-active', x === t));
        apply();
      })
    );
    apply();
  </script>
</Base>
