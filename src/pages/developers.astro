---
import Base from '@/layouts/Base.astro';
import DeveloperCard from '@/components/DeveloperCard.astro';
import Icon from '@/components/Icon.astro';
import { developers } from '@/data/developers';
import { site } from '@/data/site';

const count = developers.length;
---

<Base title="Developers — Orion OS" description="Meet the talented team of developers and maintainers building the future of Android with Orion OS.">
  <section class="relative overflow-hidden border-b border-zinc-100 bg-zinc-50/60">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute inset-0 bg-grid bg-grid-fade"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 lg:px-8">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">The Team</span>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl">Our developers</h1>
      <p class="mt-4 max-w-2xl text-lg text-zinc-500">
        A passionate crew of {count} developers, maintainers and designers — proudly building world-class software,
        from Indonesia to the world.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
      {developers.map((dev, i) => (
        <div class="reveal mb-5 break-inside-avoid" style={`transition-delay:${(i % 3) * 70}ms`}>
          <DeveloperCard dev={dev} />
        </div>
      ))}
    </div>

    <div
      class="mt-16 flex flex-col items-center justify-between gap-5 rounded-3xl px-8 py-10 text-center sm:flex-row sm:text-left"
      style="background-image:linear-gradient(135deg,#4f46e5 0%,#6d28d9 100%);"
    >
      <div>
        <h3 class="text-xl font-bold text-white sm:text-2xl">Want to contribute?</h3>
        <p class="mt-1 text-indigo-100">
          Orion OS is open source. Whether you code, design, or test — there's a place for you.
        </p>
      </div>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-brand-700 shadow-lg transition hover:bg-indigo-50"
      >
        <Icon name="github" size={18} />
        Contribute on GitHub
      </a>
    </div>
  </section>
</Base>
