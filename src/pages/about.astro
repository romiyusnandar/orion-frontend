---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

const values = [
  {
    icon: 'zap',
    title: 'Performance First',
    desc: 'We believe speed shouldn’t be a luxury. Orion OS removes unnecessary bloatware and background processes that slow down your device. Every line of code is optimized to deliver maximum performance, ensuring your phone runs as fast on day 100 as it did on day one.',
  },
  {
    icon: 'shield-check',
    title: 'Privacy Focused',
    desc: 'Your data belongs to you, not corporations. Orion OS is built on open-source code that anyone can audit. We don’t collect telemetry, we don’t track your usage, and we don’t sell your information. Complete transparency, complete control.',
  },
  {
    icon: 'feather',
    title: 'Pixel Perfect Design',
    desc: 'Beauty meets functionality. Every pixel, every animation, every interaction is carefully crafted to provide a delightful user experience. Our UI/UX team obsesses over the details so you can enjoy a polished, intuitive interface that feels natural and responsive.',
  },
];

const support = [
  {
    icon: 'coffee',
    title: 'Ko-fi',
    desc: 'Support us with a coffee on Ko-fi',
    cta: 'Buy a Coffee',
    href: site.kofi,
    accent: '#f54900',
    soft: '#fff3ed',
  },
  {
    icon: 'credit-card',
    title: 'PayPal',
    desc: 'Make a one-time donation via PayPal',
    cta: 'Donate',
    href: site.paypal,
    accent: '#0079c1',
    soft: '#eef6fd',
  },
  {
    icon: 'gift',
    title: 'Other',
    desc: 'Explore other ways to support the project',
    cta: 'Learn More',
    href: site.support,
    accent: 'var(--color-brand-600)',
    soft: 'var(--color-brand-50)',
  },
];

const impact = ['Server costs', 'Developer coffee', 'Free & open source'];
---

<Base title="About — Orion OS" description="Orion OS is an open-source, minimal and lag-free Android experience. Learn about our mission, values and how to support the project.">
  <section class="relative overflow-hidden border-b border-zinc-100">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-grid bg-grid-fade"></div>
      <div class="absolute -top-20 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-brand-200/40 blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">About</span>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-6xl">
        Redefining <span class="bg-[image:linear-gradient(90deg,var(--color-brand-600),var(--color-brand-400))] bg-clip-text text-transparent">Android</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600">
        Orion OS is an open-source project designed to provide a minimal, lag-free, and secure Android experience. We
        strip away the clutter so you can focus on what matters.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/devices" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700 sm:w-auto">
          <Icon name="download" size={18} />
          Download Now
        </a>
        <a href="/developers" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-white px-6 py-3.5 text-base font-semibold text-zinc-800 shadow-sm transition hover:bg-zinc-50 sm:w-auto">
          Meet the Team
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      {
        values.map((v, i) => (
          <div class="reveal" style={`transition-delay:${i * 70}ms`}>
            <div class="group h-full rounded-2xl border border-zinc-200 bg-white p-7 shadow-sm transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-600/10">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-100 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110 group-hover:bg-brand-600 group-hover:text-white">
                <Icon name={v.icon} size={24} />
              </span>
              <h3 class="mt-5 text-xl font-semibold text-zinc-900 transition-colors duration-300 group-hover:text-brand-700">
                {v.title}
              </h3>
              <p class="mt-2.5 leading-relaxed text-zinc-500">{v.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Proudly Indonesian -->
  <section class="border-y border-zinc-100 bg-zinc-50/60">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
        <span class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-2xl shadow-sm ring-1 ring-black/5">
          <span class="grid h-full w-full grid-rows-2">
            <span class="bg-red-600"></span>
            <span class="bg-white"></span>
          </span>
        </span>
        <div>
          <h2 class="flex flex-wrap items-center justify-center gap-3 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl md:justify-start">
            Proudly Indonesian
            <span class="rounded-lg bg-red-600 px-2 py-0.5 text-sm font-bold tracking-wide text-white">ID</span>
          </h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-zinc-600">
            OrionOS is developed by a passionate team of Indonesian developers who believe in creating world-class
            technology solutions from Indonesia. We are committed to showcasing Indonesian talent in the global
            open-source community while providing the best Android experience for users worldwide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Support / Donation -->
  <section class="donate mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-3.5 py-1.5 text-sm font-semibold text-rose-600 ring-1 ring-rose-100">
        <Icon name="heart" size={15} />
        Support us
      </span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">Keep the project alive</h2>
      <p class="mt-4 text-lg text-zinc-500">
        Orion OS is free and open source. Your support helps us cover server costs and coffee for developers.
      </p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-2">
        {
          impact.map((t) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-600 shadow-sm">
              <Icon name="check" size={14} class="text-emerald-500" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        support.map((s, i) => (
          <div class="reveal" style={`transition-delay:${i * 70}ms`}>
            <div class="group flex h-full flex-col rounded-2xl border border-zinc-200 bg-white p-7 shadow-sm transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:shadow-xl">
              <span
                class="grid h-12 w-12 place-items-center rounded-xl transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110"
                style={`background-color:${s.soft};color:${s.accent};`}
              >
                <Icon name={s.icon} size={24} />
              </span>
              <h3 class="mt-5 text-lg font-semibold text-zinc-900">{s.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-500">{s.desc}</p>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:brightness-[0.94] active:scale-[0.98]"
                style={`background-color:${s.accent};`}
              >
                {s.cta}
                <Icon name="arrow-up-right" size={16} />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-12 text-center text-sm text-zinc-400">Built by passionate developers from around the world.</p>
    <div class="mt-3 text-center">
      <a href="/developers" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700">
        Meet the Team
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>
</Base>
