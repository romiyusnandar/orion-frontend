---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

const values = [
  {
    icon: 'zap',
    title: 'Performance First',
    desc: 'Speed shouldn’t be a luxury. We strip away bloatware and background processes so your phone runs as fast on day 100 as it did on day one.',
  },
  {
    icon: 'shield-check',
    title: 'Privacy Focused',
    desc: 'Your data belongs to you. We build on open-source code anyone can audit — no telemetry, no tracking, no selling your information.',
  },
  {
    icon: 'feather',
    title: 'Pixel Perfect Design',
    desc: 'Every pixel, animation and interaction is crafted for a delightful experience. A polished, intuitive interface that feels natural.',
  },
];

const support = [
  {
    title: 'Ko-fi',
    desc: 'Support us with a coffee on Ko-fi',
    cta: 'Buy a Coffee',
    href: site.kofi,
    accent: '#f59e0b',
  },
  {
    title: 'PayPal',
    desc: 'Make a one-time donation via PayPal',
    cta: 'Donate',
    href: site.paypal,
    accent: '#2563eb',
  },
  {
    title: 'Other',
    desc: 'Explore other ways to support the project',
    cta: 'Learn More',
    href: site.support,
    accent: '#7c3aed',
  },
];
---

<Base title="About — Orion OS" description="Orion OS is an open-source, minimal and lag-free Android experience. Learn about our mission, values and how to support the project.">
  <section class="relative overflow-hidden border-b border-zinc-100">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-dots bg-dots-fade"></div>
      <div class="absolute -top-20 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-brand-200/40 blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">About</span>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-6xl">
        Redefining <span class="bg-[image:linear-gradient(90deg,#4f46e5,#8b5cf6)] bg-clip-text text-transparent">Android</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600">
        Orion OS is an open-source project designed to deliver a minimal, lag-free, and secure Android experience. We
        strip away the clutter so you can focus on what matters.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/devices" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700 sm:w-auto">
          <Icon name="download" size={18} />
          Download Now
        </a>
        <a href="/developers" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-white px-6 py-3.5 text-base font-semibold text-zinc-800 shadow-sm transition hover:bg-zinc-50 sm:w-auto">
          Meet the Team
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      {
        values.map((v, i) => (
          <div
            class="reveal rounded-2xl border border-zinc-200 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-600/5"
            style={`transition-delay:${i * 70}ms`}
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl text-brand-600 ring-1 ring-brand-100" style="background-image:linear-gradient(135deg,#eef2ff,#f5f3ff);">
              <Icon name={v.icon} size={24} />
            </span>
            <h3 class="mt-5 text-xl font-semibold text-zinc-900">{v.title}</h3>
            <p class="mt-2.5 leading-relaxed text-zinc-500">{v.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Proudly Indonesian -->
  <section class="border-y border-zinc-100 bg-zinc-50/60">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
        <span class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-2xl shadow-sm ring-1 ring-black/5">
          <span class="grid h-full w-full grid-rows-2">
            <span class="bg-red-600"></span>
            <span class="bg-white"></span>
          </span>
        </span>
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">Proudly Indonesian</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-zinc-600">
            Orion OS is developed by a passionate team of Indonesian developers who believe in creating world-class
            technology from Indonesia. We’re committed to showcasing Indonesian talent in the global open-source
            community while delivering the best Android experience to users worldwide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Support -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">Keep the project alive</h2>
      <p class="mt-4 text-lg text-zinc-500">
        Orion OS is free and open source. Your support helps cover server costs — and the developer coffee.
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        support.map((s) => (
          <div class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-7 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <span class="mx-auto grid h-12 w-12 place-items-center rounded-xl text-lg font-bold text-white" style={`background-color:${s.accent};`}>
              {s.title.charAt(0)}
            </span>
            <h3 class="mt-5 text-lg font-semibold text-zinc-900">{s.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-500">{s.desc}</p>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-800 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50"
            >
              {s.cta}
              <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
        ))
      }
    </div>

    <p class="mt-12 text-center text-sm text-zinc-400">Built by passionate developers from around the world.</p>
  </section>
</Base>
