---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import DeviceCard from '@/components/DeviceCard.astro';
import Icon from '@/components/Icon.astro';
import { features, site } from '@/data/site';
import { devices } from '@/data/devices';
import { latestChangelog } from '@/data/changelogs';

const preview = devices.slice(0, 4);
---

<Base title="Orion OS — Pure Performance. Lightweight, secure, minimal Android.">
  <Hero />

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <SectionHeading
      eyebrow="Why Orion"
      title="Built for Excellence"
      subtitle="Every feature is designed to give you the best possible Android experience — fast, clean, and in your control."
    />
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f, i) => (
          <div class="reveal" style={`transition-delay:${i * 60}ms`}>
            <div
              class="group h-full rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-600/10"
            >
              <span
                class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-100 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110 group-hover:bg-brand-600 group-hover:text-white"
              >
                <Icon name={f.icon} size={24} />
              </span>
              <h3 class="mt-5 text-lg font-semibold text-zinc-900 transition-colors duration-300 group-hover:text-brand-700">
                {f.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-500">{f.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Devices preview -->
  <section class="border-y border-zinc-100 bg-zinc-50/60">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading
          align="left"
          eyebrow="Download"
          title="Find your device"
          subtitle="Grab the latest official build for your model. Flash, boot, and feel the difference."
        />
        <a
          href="/devices"
          class="hidden shrink-0 items-center gap-2 rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-800 shadow-sm transition hover:border-zinc-300 hover:bg-zinc-50 sm:inline-flex"
        >
          View all devices
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {preview.map((d) => (
          <DeviceCard device={d} />
        ))}
      </div>
      <a
        href="/devices"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-200 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-800 shadow-sm transition hover:border-zinc-300 sm:hidden"
      >
        View all devices
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- Latest release highlight -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <div
      class="relative overflow-hidden rounded-3xl border border-brand-100 p-8 sm:p-12"
      style="background-image:linear-gradient(135deg,var(--color-brand-50) 0%,#ffffff 100%);"
    >
      <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-white/40 blur-2xl"></div>
      <div class="relative grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white">
            <Icon name="sparkles" size={14} />
            {latestChangelog.android}
          </span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">
            {latestChangelog.version} <span class="text-brand-600">{latestChangelog.codename}</span>
          </h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-zinc-600">{latestChangelog.description}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="/changelogs"
              class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700"
            >
              Read the changelog
              <Icon name="arrow-right" size={16} />
            </a>
            <a
              href="/devices"
              class="inline-flex items-center gap-2 rounded-xl border border-zinc-200 bg-white px-5 py-3 text-sm font-semibold text-zinc-800 shadow-sm transition hover:bg-zinc-50"
            >
              <Icon name="download" size={16} />
              Download
            </a>
          </div>
        </div>
        <ul class="grid gap-3">
          {
            latestChangelog.whatsNew.slice(0, 4).map((line) => (
              <li class="flex items-start gap-3 rounded-xl bg-white/70 p-4 text-sm font-medium text-zinc-700 ring-1 ring-white/70 backdrop-blur-sm">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-brand-500" />
                {line}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-3xl px-6 py-16 text-center sm:px-12"
      style="background-image:linear-gradient(135deg,var(--color-brand-600) 0%,var(--color-brand-800) 100%);"
    >
      <div class="absolute inset-0 bg-dots opacity-20"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Ready to go faster?</h2>
        <p class="mt-4 text-lg text-brand-100">
          Join thousands of users running a cleaner, lighter, more private Android. It's free and open source.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/devices"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-6 py-3.5 text-base font-semibold text-brand-700 shadow-lg transition hover:bg-brand-50 active:scale-[0.98] sm:w-auto"
          >
            <Icon name="download" size={18} />
            Download Now
          </a>
          <a
            href={site.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/10 px-6 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition hover:bg-white/20 sm:w-auto"
          >
            <Icon name="telegram" size={18} />
            Join the community
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
