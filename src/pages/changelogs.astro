---
import Base from '@/layouts/Base.astro';
import ChangelogItem from '@/components/ChangelogItem.astro';
import Icon from '@/components/Icon.astro';
import { changelogs } from '@/data/changelogs';

const total = changelogs.length;
---

<Base title="Changelog — Orion OS" description="Track the evolution of Orion OS with detailed release notes for every version, from Cosmic to Ozone.">
  <section class="border-b border-zinc-100 bg-zinc-50/60">
    <div class="mx-auto max-w-4xl px-4 pt-16 pb-12 sm:px-6 lg:px-8">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Release Notes</span>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl">Changelog</h1>
      <p class="mt-4 max-w-2xl text-lg text-zinc-500">
        Track the evolution of Orion OS — {total} releases and counting, from the first Cosmic build to the latest
        molecular UI.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="relative">
      <div class="absolute bottom-6 left-[11px] top-6 w-px bg-zinc-200"></div>
      <div class="space-y-6">
        {
          changelogs.map((entry, i) => (
            <div class="relative pl-10 sm:pl-12">
              <span class="absolute left-0 top-7 grid h-6 w-6 place-items-center rounded-full bg-white ring-1 ring-zinc-200">
                <span class:list={['h-2.5 w-2.5 rounded-full', i === 0 ? 'bg-brand-600' : 'bg-zinc-300']}></span>
              </span>
              <ChangelogItem entry={entry} index={i} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16 rounded-2xl border border-zinc-200 bg-white p-6 text-center shadow-sm">
      <Icon name="sparkles" size={24} class="mx-auto text-brand-500" />
      <h3 class="mt-3 text-lg font-semibold text-zinc-900">Want early access to the next release?</h3>
      <p class="mt-1 text-sm text-zinc-500">Follow the project on Telegram for drop alerts and beta builds.</p>
      <a
        href="https://t.me/OrionOS_Update"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
      >
        <Icon name="telegram" size={16} />
        Follow on Telegram
      </a>
    </div>
  </section>
</Base>
