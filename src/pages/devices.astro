---
import Base from '@/layouts/Base.astro';
import DeviceCard from '@/components/DeviceCard.astro';
import Icon from '@/components/Icon.astro';
import { devices } from '@/data/devices';
---

<Base title="Download — Orion OS" description="Find and download the latest official Orion OS build for your device. GApps and Vanilla variants.">
  <section class="relative overflow-hidden border-b border-zinc-100 bg-zinc-50/60">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute inset-0 bg-grid bg-grid-fade"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-10 sm:px-6 lg:px-8">
      <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">Download</span>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl">Find your device</h1>
      <p class="mt-4 max-w-2xl text-lg text-zinc-500">
        Search {devices.length} supported devices and download the latest official build for your model.
      </p>

      <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <label class="relative block w-full max-w-md">
          <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-zinc-400">
            <Icon name="search" size={18} />
          </span>
          <input
            id="device-search"
            type="search"
            placeholder="Search by name, codename or maintainer…"
            autocomplete="off"
            class="w-full rounded-xl border border-zinc-200 bg-white py-3 pl-11 pr-4 text-sm text-zinc-800 shadow-sm outline-none transition placeholder:text-zinc-400 focus:border-brand-400 focus:ring-4 focus:ring-brand-100"
          />
        </label>

        <div class="flex items-center gap-1.5 self-start rounded-xl border border-zinc-200 bg-white p-1 shadow-sm">
          <button data-filter="all" class="filter-tab is-active rounded-lg px-3.5 py-1.5 text-sm font-semibold text-zinc-600">All</button>
          <button data-filter="active" class="filter-tab rounded-lg px-3.5 py-1.5 text-sm font-semibold text-zinc-600">Active</button>
          <button data-filter="discontinued" class="filter-tab rounded-lg px-3.5 py-1.5 text-sm font-semibold text-zinc-600">Discontinued</button>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div id="device-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {devices.map((d) => <DeviceCard device={d} />)}
    </div>

    <div id="device-empty" class="hidden rounded-2xl border border-dashed border-zinc-200 bg-zinc-50/50 px-6 py-16 text-center">
      <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-white text-zinc-400 ring-1 ring-zinc-200">
        <Icon name="search" size={26} />
      </span>
      <h3 class="mt-4 text-lg font-semibold text-zinc-800">No devices found</h3>
      <p class="mt-1 text-sm text-zinc-500">We couldn't find a match. Try a different keyword or reset the filters.</p>
      <button id="device-reset" class="mt-5 inline-flex items-center gap-2 rounded-xl border border-zinc-200 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 shadow-sm transition hover:bg-zinc-50">
        <Icon name="x" size={16} />
        Reset
      </button>
    </div>
  </section>

  <script>
    const input = document.getElementById('device-search') as HTMLInputElement | null;
    const empty = document.getElementById('device-empty') as HTMLDivElement | null;
    const reset = document.getElementById('device-reset') as HTMLButtonElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.device-card'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-tab'));
    let filter = 'all';

    const apply = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const matchQ = card.dataset.search?.includes(q) ?? false;
        const matchStatus = filter === 'all' || card.dataset.status === filter;
        const show = matchQ && matchStatus;
        card.classList.toggle('hidden', !show);
        if (show) shown++;
      }
      if (empty) empty.classList.toggle('hidden', shown !== 0);
    };

    input?.addEventListener('input', apply);
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        filter = t.dataset.filter ?? 'all';
        tabs.forEach((x) => x.classList.toggle('is-active', x === t));
        apply();
      })
    );
    reset?.addEventListener('click', () => {
      input?.focus();
      if (input) input.value = '';
      filter = 'all';
      tabs.forEach((x) => x.classList.toggle('is-active', x.dataset.filter === 'all'));
      apply();
    });
    apply();
  </script>
</Base>
