---
import DashboardLayout from "../../layouts/DashboardLayout.astro";

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
---

<DashboardLayout title="Manage Builds">
    <div class="builds-page">
        <!-- Header -->
        <div class="page-header">
            <div>
                <h1 class="page-title">Manage Builds</h1>
                <p class="page-description">
                    Manage ROM build releases for all devices
                </p>
            </div>
            <button class="btn-primary" id="addBuildBtn">
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Add Build</span>
            </button>
        </div>

        <!-- Filter and Counter -->
        <div class="filter-section">
            <div class="filter-wrapper">
                <label for="deviceFilter">Filter by Device:</label>
                <select id="deviceFilter" class="device-filter">
                    <option value="">All Devices</option>
                </select>
            </div>
            <div class="build-counter">
                <span class="counter-label">Total Builds:</span>
                <span class="counter-value" id="totalBuildsCount">0</span>
            </div>
        </div>

        <!-- Builds Table -->
        <div class="table-container">
            <table class="builds-table">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Version</th>
                        <th>Type</th>
                        <th>File Size</th>
                        <th>Released</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="buildsTableBody">
                    <!-- Loading State -->
                    <tr class="loading-row">
                        <td colspan="6">
                            <div class="loading-spinner"></div>
                            <p>Loading builds...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div class="empty-state" id="emptyState" style="display: none;">
            <svg
                width="64"
                height="64"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path
                    d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                ></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <h3>No builds found</h3>
            <p>Get started by releasing your first build</p>
            <button class="btn-primary add-build-trigger">Add Build</button>
        </div>

        <!-- Toast Notification -->
        <div id="toast" class="toast" style="display: none;">
            <div class="toast-content">
                <div class="toast-icon" id="toastIcon"></div>
                <div class="toast-message" id="toastMessage"></div>
            </div>
        </div>
    </div>
</DashboardLayout>

<style>
    .builds-page {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Page Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
        gap: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 0.5rem 0;
    }

    .page-description {
        color: var(--color-text-secondary);
        margin: 0;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: var(--color-orion);
        color: white;
        border: none;
        border-radius: var(--radius-lg);
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all var(--transition-base);
        white-space: nowrap;
    }

    .btn-primary:hover {
        background: var(--color-orion-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    /* Filter Section */
    .filter-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        gap: 1.5rem;
    }

    .filter-wrapper {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .filter-wrapper label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        white-space: nowrap;
    }

    .device-filter {
        min-width: 250px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        color: var(--color-text-primary);
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all var(--transition-base);
        font-family: inherit;
    }

    .device-filter:focus {
        outline: none;
        border-color: var(--color-orion);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .build-counter {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        white-space: nowrap;
    }

    .counter-label {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        font-weight: 500;
    }

    .counter-value {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-orion);
    }

    /* Table Styles */
    .table-container {
        background: var(--color-bg-secondary);
        border-radius: var(--radius-xl);
        border: 1px solid var(--color-border);
        overflow: hidden;
    }

    .builds-table {
        width: 100%;
        border-collapse: collapse;
    }

    .builds-table th {
        padding: 1.25rem 1rem;
        text-align: left;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: var(--color-bg-tertiary);
        border-bottom: 1px solid var(--color-border);
    }

    .builds-table tbody tr {
        border-bottom: 2px solid var(--color-border);
        transition: background var(--transition-base);
    }

    .builds-table tbody tr:last-child {
        border-bottom: none;
    }

    .builds-table tbody tr:hover {
        background: var(--color-bg-tertiary);
    }

    .builds-table td {
        padding: 1.25rem 1rem;
        color: var(--color-text-primary);
        vertical-align: middle;
    }

    /* Device Info */
    .device-name {
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .device-codename {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        font-family: "Courier New", monospace;
        font-weight: 400;
    }

    /* Build Type Badge */
    .type-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.375rem 0.75rem;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .type-badge.vanilla {
        background: rgba(99, 102, 241, 0.1);
        color: var(--color-orion);
    }

    .type-badge.gapps {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    /* Version */
    .version {
        font-weight: 600;
        color: var(--color-text-primary);
    }

    /* File Size */
    .file-size {
        color: var(--color-text-secondary);
    }

    /* Date */
    .release-date {
        color: var(--color-text-secondary);
        font-size: 0.875rem;
    }

    /* Actions */
    .actions {
        display: flex;
        gap: 0.75rem;
    }

    .btn-action {
        padding: 0.625rem;
        min-width: 38px;
        min-height: 38px;
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        color: var(--color-text-secondary);
        cursor: pointer;
        transition: all var(--transition-base);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-action svg {
        width: 20px;
        height: 20px;
    }

    .btn-action:hover {
        background: var(--color-bg-tertiary);
        border-color: var(--color-orion);
        color: var(--color-orion);
    }

    .btn-action.delete:hover {
        border-color: #ef4444;
        color: #ef4444;
    }

    /* Loading State */
    .loading-row td {
        text-align: center;
        padding: 3rem;
    }

    .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid var(--color-border);
        border-top-color: var(--color-orion);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 1rem;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
    }

    .empty-state svg {
        color: var(--color-text-tertiary);
        margin: 0 auto 1rem auto;
        display: block;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 0.5rem 0;
    }

    .empty-state p {
        color: var(--color-text-secondary);
        margin: 0 0 1.5rem 0;
    }

    /* Toast Notification */
    .toast {
        position: fixed;
        top: 2rem;
        right: 2rem;
        z-index: 9999;
        min-width: 300px;
        max-width: 400px;
        animation: slideIn 0.3s ease-out;
    }

    .toast.hide {
        animation: slideOut 0.3s ease-out forwards;
    }

    .toast-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        background: var(--color-bg-primary);
        border-radius: var(--radius-lg);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        border-left: 4px solid var(--color-orion);
    }

    .toast.success .toast-content {
        border-left-color: #10b981;
    }

    .toast.error .toast-content {
        border-left-color: #ef4444;
    }

    .toast-icon {
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .toast.success .toast-icon::before {
        content: "✓";
        color: #10b981;
    }

    .toast.error .toast-icon::before {
        content: "✕";
        color: #ef4444;
    }

    .toast-message {
        color: var(--color-text-primary);
        font-size: 0.9375rem;
        font-weight: 500;
    }

    /* Contributor mode - hide delete buttons */
    body.contributor-mode .btn-action.delete {
        display: none !important;
    }

    @keyframes slideIn {
        from {
            transform: translateX(400px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes slideOut {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(400px);
            opacity: 0;
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .builds-page {
            padding: 1rem;
        }

        .page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }

        .btn-primary {
            width: 100%;
            justify-content: center;
        }

        .filter-section {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }

        .filter-wrapper {
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
        }

        .device-filter {
            width: 100%;
        }

        .build-counter {
            width: 100%;
            justify-content: space-between;
        }

        .table-container {
            border: none;
            background: transparent;
            border-radius: 0;
            overflow: visible;
        }

        /* Card Layout for Table on Mobile */
        .builds-table thead {
            display: none;
        }

        .builds-table,
        .builds-table tbody,
        .builds-table tr {
            display: block;
            width: 100%;
        }

        .builds-table tbody tr {
            margin-bottom: 1rem;
            background: var(--color-bg-secondary);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .builds-table td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--color-border);
            text-align: right;
        }

        .builds-table td:last-child {
            border-bottom: none;
            padding-top: 1rem;
            justify-content: flex-end;
        }

        .builds-table td::before {
            content: attr(data-label);
            font-weight: 600;
            color: var(--color-text-secondary);
            font-size: 0.875rem;
            text-align: left;
            margin-right: 1rem;
        }

        /* Special styling for Device Name */
        .builds-table td[data-label="Device"] {
            justify-content: center;
            padding-top: 0;
            border-bottom: 1px solid var(--color-border);
            margin-bottom: 0.5rem;
        }

        .builds-table td[data-label="Device"]::before {
            display: none;
        }

        .builds-table td[data-label="Device"] .device-name {
            font-size: 1.125rem;
            font-weight: 700;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .actions {
            width: 100%;
            justify-content: flex-end;
            gap: 1rem;
        }

        .btn-action {
            min-width: 44px;
            min-height: 44px;
        }

        .toast {
            top: 1rem;
            right: 1rem;
            left: 1rem;
            min-width: auto;
        }
    }
</style>

<script define:vars={{ API_BASE_URL }}>
    // Toast notification function
    function showToast(message, type = "success") {
        const toast = document.getElementById("toast");
        const toastMessage = document.getElementById("toastMessage");

        if (!toast || !toastMessage) return;

        toastMessage.textContent = message;
        toast.className = `toast ${type}`;
        toast.style.display = "block";

        setTimeout(() => {
            toast.classList.add("hide");
            setTimeout(() => {
                toast.style.display = "none";
                toast.classList.remove("hide");
            }, 300);
        }, 3000);
    }

    // Store all builds
    let allBuilds = [];
    let currentUserIsAdmin = true; // Global variable to track admin status

    // Fetch builds
    async function fetchBuilds() {
        const tableBody = document.getElementById("buildsTableBody");
        const emptyState = document.getElementById("emptyState");
        const deviceFilter = document.getElementById("deviceFilter");
        const totalCount = document.getElementById("totalBuildsCount");

        try {
            // Get user role to determine endpoint
            const authUser = localStorage.getItem("auth_user");
            const token = localStorage.getItem("auth_token");
            let user = null;
            let isAdmin = false;

            if (authUser) {
                try {
                    user = JSON.parse(authUser);
                    const adminRoles = ["ADMIN", "FOUNDER", "CO_FOUNDER"];
                    isAdmin = adminRoles.includes(user.role);
                } catch (e) {
                    console.error("Error parsing user:", e);
                }
            }

            // Determine API endpoint based on role
            const endpoint = isAdmin
                ? `${API_BASE_URL}/builds`
                : `${API_BASE_URL}/builds/my/builds`;

            // Prepare fetch options
            const fetchOptions = isAdmin
                ? {} // Admin doesn't need auth for /builds
                : {
                      headers: {
                          Authorization: `Bearer ${token}`,
                      },
                  };

            const response = await fetch(endpoint, fetchOptions);
            const data = await response.json();

            if (data.success && data.data && data.data.length > 0) {
                // Store all builds
                allBuilds = data.data;

                if (emptyState) emptyState.style.display = "none";

                // Update total counter
                if (totalCount) totalCount.textContent = allBuilds.length;

                // Populate device filter
                if (deviceFilter) {
                    const devices = {};
                    allBuilds.forEach((build) => {
                        if (!devices[build.device.id]) {
                            devices[build.device.id] = build.device;
                        }
                    });

                    const deviceOptions = Object.values(devices)
                        .map(
                            (device) =>
                                `<option value="${device.id}">${device.name} (${device.codename})</option>`,
                        )
                        .join("");

                    deviceFilter.innerHTML =
                        '<option value="">All Devices</option>' + deviceOptions;
                }

                // Store admin status globally
                currentUserIsAdmin = isAdmin;

                // Display builds
                displayBuilds(allBuilds, isAdmin);
            } else {
                tableBody.innerHTML = "";
                if (emptyState) emptyState.style.display = "block";
                if (totalCount) totalCount.textContent = "0";
            }
        } catch (error) {
            console.error("Error fetching builds:", error);
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem; color: var(--color-text-secondary);">
                        Failed to load builds. Please try again.
                    </td>
                </tr>
            `;
        }
    }

    // Display builds in table
    function displayBuilds(builds, isAdmin = true) {
        const tableBody = document.getElementById("buildsTableBody");
        const totalCount = document.getElementById("totalBuildsCount");

        if (totalCount) totalCount.textContent = builds.length;

        tableBody.innerHTML = builds
            .map(
                (build) => `
            <tr>
                <td data-label="Device">
                    <div class="device-name">
                        ${build.device.name} <span class="device-codename">(${build.device.codename})</span>
                    </div>
                </td>
                <td data-label="Version">
                    <span class="version">${build.version}</span>
                </td>
                <td data-label="Type">
                    <span class="type-badge ${build.type.toLowerCase()}">${build.type}</span>
                </td>
                <td data-label="File Size">
                    <span class="file-size">${build.fileSize}</span>
                </td>
                <td data-label="Released">
                    <span class="release-date">${formatDate(build.createdAt)}</span>
                </td>
                <td data-label="Actions">
                    <div class="actions">
                        <button class="btn-action" onclick="editBuild('${build.id}')" title="Edit">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                        </button>
                        ${
                            isAdmin
                                ? `
                        <button class="btn-action delete" onclick="deleteBuild('${build.id}', '${build.version}')" title="Delete">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                        `
                                : ""
                        }
                    </div>
                </td>
            </tr>
        `,
            )
            .join("");
    }

    // Format date
    function formatDate(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diffTime = Math.abs(now - date);
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

        if (diffDays < 1) {
            return "Today";
        } else if (diffDays < 2) {
            return "Yesterday";
        } else if (diffDays < 7) {
            return `${diffDays} days ago`;
        } else {
            return date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
            });
        }
    }

    // Edit build (placeholder)
    window.editBuild = function (id) {
        alert(`Edit build: ${id}\n\nThis feature will be implemented next.`);
    };

    // Delete build (placeholder)
    window.deleteBuild = function (id, version) {
        if (
            confirm(
                `Are you sure you want to delete "${version}"?\n\nThis action cannot be undone.`,
            )
        ) {
            alert(
                `Delete build: ${id}\n\nThis feature will be implemented next.`,
            );
        }
    };

    // Add build button
    const addBuildBtn = document.getElementById("addBuildBtn");
    addBuildBtn?.addEventListener("click", () => {
        alert("Add build form will be implemented next.");
    });

    // Device filter event listener
    const deviceFilter = document.getElementById("deviceFilter");
    deviceFilter?.addEventListener("change", (e) => {
        const selectedDeviceId = e.target.value;

        if (selectedDeviceId) {
            // Filter builds by device
            const filteredBuilds = allBuilds.filter(
                (build) => build.device.id === selectedDeviceId,
            );
            displayBuilds(filteredBuilds, currentUserIsAdmin);
        } else {
            // Show all builds
            displayBuilds(allBuilds, currentUserIsAdmin);
        }
    });

    // Load builds on page load
    fetchBuilds();

    // Role-based button visibility
    (function () {
        const authUser = localStorage.getItem("auth_user");
        if (authUser) {
            try {
                const user = JSON.parse(authUser);
                const adminRoles = ["ADMIN", "FOUNDER", "CO_FOUNDER"];
                const isAdmin = adminRoles.includes(user.role);

                if (!isAdmin) {
                    // Add contributor-mode class to hide delete buttons
                    document.body.classList.add("contributor-mode");
                }
            } catch (e) {
                console.error("Error checking user role:", e);
            }
        }
    })();
</script>
