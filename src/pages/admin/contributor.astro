---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Contributor Dashboard">
    <div class="contributor-dashboard">
        <div class="welcome-section">
            <h1 class="page-title">Contributor Dashboard</h1>
            <p class="page-description">
                Welcome! You have contributor access to manage devices, builds,
                and announcements.
            </p>
        </div>

        <!-- Quick Access Cards -->
        <div class="quick-access-grid">
            <!-- Edit Devices -->
            <a href="/admin/devices" class="access-card">
                <div class="card-icon">
                    <svg
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"
                        ></rect>
                        <line x1="12" y1="18" x2="12.01" y2="18"></line>
                    </svg>
                </div>
                <h3>Edit Devices</h3>
                <p>Update device information</p>
                <span class="access-badge">Edit Only</span>
            </a>

            <!-- Manage Builds -->
            <a href="/admin/builds" class="access-card">
                <div class="card-icon">
                    <svg
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                        ></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"
                        ></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </div>
                <h3>Manage Builds</h3>
                <p>Add and edit ROM builds</p>
                <span class="access-badge">Add & Edit</span>
            </a>

            <!-- Announcements -->
            <a href="/admin/announcements" class="access-card">
                <div class="card-icon">
                    <svg
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"
                        ></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                </div>
                <h3>Announcements</h3>
                <p>Manage announcements</p>
                <span class="access-badge full">Full Access</span>
            </a>
        </div>

        <!-- Access Info -->
        <div class="access-info">
            <h2>Your Access Level</h2>
            <div class="access-details">
                <div class="access-item">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Edit existing devices</span>
                </div>
                <div class="access-item">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Add and edit builds</span>
                </div>
                <div class="access-item">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Full access to announcements</span>
                </div>
                <div class="access-item disabled">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    <span>Cannot add or delete devices</span>
                </div>
                <div class="access-item disabled">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    <span>Cannot delete builds</span>
                </div>
            </div>
        </div>
    </div>
</DashboardLayout>

<style>
    .contributor-dashboard {
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .welcome-section {
        margin-bottom: 3rem;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 0.5rem 0;
    }

    .page-description {
        font-size: 1.125rem;
        color: var(--color-text-secondary);
        margin: 0;
    }

    /* Quick Access Grid */
    .quick-access-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .access-card {
        position: relative;
        padding: 2rem;
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        text-decoration: none;
        transition: all var(--transition-base);
        overflow: hidden;
    }

    .access-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--color-orion);
        transform: scaleX(0);
        transition: transform var(--transition-base);
    }

    .access-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        border-color: var(--color-orion);
    }

    .access-card:hover::before {
        transform: scaleX(1);
    }

    .card-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(99, 102, 241, 0.1);
        border-radius: var(--radius-lg);
        margin-bottom: 1.5rem;
        color: var(--color-orion);
    }

    .access-card h3 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 0.5rem 0;
    }

    .access-card p {
        color: var(--color-text-secondary);
        margin: 0 0 1rem 0;
    }

    .access-badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        background: rgba(251, 191, 36, 0.1);
        color: #f59e0b;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .access-badge.full {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    /* Access Info */
    .access-info {
        padding: 2rem;
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
    }

    .access-info h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 1.5rem 0;
    }

    .access-details {
        display: grid;
        gap: 1rem;
    }

    .access-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--color-bg-tertiary);
        border-radius: var(--radius-md);
        color: var(--color-text-primary);
    }

    .access-item svg {
        flex-shrink: 0;
        color: #10b981;
    }

    .access-item.disabled {
        opacity: 0.6;
    }

    .access-item.disabled svg {
        color: #ef4444;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .contributor-dashboard {
            padding: 1rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .quick-access-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .access-card {
            padding: 1.5rem;
        }
    }
</style>

<script>
    // Check if user has contributor access
    const adminUser = localStorage.getItem("auth_user");
    if (adminUser) {
        const user = JSON.parse(adminUser);
        const adminRoles = ["ADMIN", "FOUNDER", "CO_FOUNDER"];

        // If user is admin, redirect to full dashboard
        if (adminRoles.includes(user.role)) {
            window.location.href = "/admin/dashboard";
        }
    } else {
        // No user data, redirect to login
        window.location.href = "/admin/login";
    }
</script>
