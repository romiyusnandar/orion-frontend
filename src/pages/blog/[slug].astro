---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Avatar from '@/components/Avatar.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id } }));
}
const slug = Astro.params.slug ?? '';
const posts = await getCollection('blog');
const found = posts.find((p) => p.id === slug);
if (!found) Astro.redirect('/blog', 301);
const post = found as CollectionEntry<'blog'>;
const html = post.rendered?.html ?? '';

const words = post.body?.trim().split(/\s+/).length ?? 0;
const readTime = Math.max(1, Math.ceil(words / 200));
const date = post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(`${site.url}/blog/${post.id}`);
---

<Base
  title={`${post.data.title} — Orion OS Blog`}
  description={post.data.description}
  type="article"
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 transition-colors hover:text-brand-700"
    >
      <Icon name="arrow-right" size={16} class="rotate-180" />
      Back to blog
    </a>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-2">
        {
          post.data.tags.map((t) => (
            <a href="/blog" class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700 ring-1 ring-brand-100">
              {t}
            </a>
          ))
        }
        {post.data.device && <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-500">{post.data.device}</span>}
      </div>

      <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-zinc-900 sm:text-4xl">
        {post.data.title}
      </h1>

      <div class="mt-6 flex items-center gap-3 border-b border-zinc-100 pb-6">
        <Avatar name={post.data.author} size={44} />
        <div class="text-sm">
          <p class="font-semibold text-zinc-800">{post.data.author}</p>
          <p class="text-zinc-400">
            {date} · {readTime} min read
          </p>
        </div>
      </div>
    </header>

    <div class="prose-orion mt-8" set:html={html}></div>

    <footer class="mt-12 border-t border-zinc-100 pt-8">
      <div class="flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
        <div class="text-sm text-zinc-500">Share this article</div>
        <div class="flex items-center gap-2">
          <a
            href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-2 text-sm font-medium text-zinc-700 shadow-sm transition hover:bg-zinc-50"
          >
            <Icon name="arrow-up-right" size={15} />
            X / Twitter
          </a>
          <a
            href={`https://t.me/share/url?url=${shareUrl}&text=${shareTitle}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-2 text-sm font-medium text-zinc-700 shadow-sm transition hover:bg-zinc-50"
          >
            <Icon name="telegram" size={15} />
            Telegram
          </a>
          <button
            id="copy-link"
            class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-2 text-sm font-medium text-zinc-700 shadow-sm transition hover:bg-zinc-50"
          >
            <Icon name="check" size={15} class="copy-check hidden text-emerald-500" />
            <span class="copy-label">Copy link</span>
          </button>
        </div>
      </div>

      {
        post.data.deviceCode && (
          <a
            href={`/devices/${post.data.deviceCode}`}
            class="mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl border border-brand-100 p-6 sm:flex-row sm:items-center"
            style="background-image:linear-gradient(135deg,#eef2ff,#f5f3ff);"
          >
            <div class="flex items-center gap-4">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-white text-brand-600 ring-1 ring-brand-100">
                <Icon name="smartphone" size={24} />
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Get it now</p>
                <p class="text-base font-semibold text-zinc-900">Download Orion OS for {post.data.device}</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
              Go to device page
              <Icon name="arrow-right" size={16} />
            </span>
          </a>
        )
      }
    </footer>
  </article>

  <script>
    const btn = document.getElementById('copy-link') as HTMLButtonElement | null;
    btn?.addEventListener('click', async () => {
      const check = btn.querySelector<HTMLElement>('.copy-check');
      const label = btn.querySelector<HTMLElement>('.copy-label');
      try {
        await navigator.clipboard.writeText(window.location.href);
        check?.classList.remove('hidden');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          check?.classList.add('hidden');
          if (label) label.textContent = 'Copy link';
        }, 1800);
      } catch {
        /* clipboard unavailable */
      }
    });
  </script>
</Base>
