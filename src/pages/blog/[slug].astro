---
export const prerender = true; // Pre-render halaman ini meskipun output: 'server'

import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Generate static paths untuk semua blog posts
export async function getStaticPaths() {
    const blogEntries = await getCollection("blog");
    return blogEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Format tanggal
function formatDate(date: Date): string {
    return new Intl.DateTimeFormat("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    }).format(date);
}
---

<Layout
    title={`${entry.data.title} - Orion OS Blog`}
    description={entry.data.description}
>
    <article class="article-page">
        <div class="container">
            <!-- Back Button -->
            <div class="back-button-wrapper">
                <a href="/blog" class="back-button">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Blog
                </a>
            </div>

            <!-- Article Header -->
            <header class="article-header">
                <!-- Tags -->
                {
                    entry.data.tags && entry.data.tags.length > 0 && (
                        <div class="article-tags">
                            {entry.data.tags.map((tag) => (
                                <span class="tag">{tag}</span>
                            ))}
                        </div>
                    )
                }

                <!-- Title -->
                <h1 class="article-title">
                    {entry.data.title}
                </h1>

                <!-- Description -->
                <p class="article-description">
                    {entry.data.description}
                </p>

                <!-- Meta -->
                <div class="article-meta">
                    <div class="meta-author">
                        <div class="author-avatar">
                            {
                                entry.data.authorImage ? (
                                    <img
                                        src={entry.data.authorImage}
                                        alt={entry.data.author}
                                        class="avatar-img"
                                    />
                                ) : (
                                    <span>{entry.data.author.charAt(0)}</span>
                                )
                            }
                        </div>
                        <div class="author-info">
                            <p class="author-name">{entry.data.author}</p>
                            <time
                                datetime={entry.data.pubDate.toISOString()}
                                class="post-date"
                            >
                                {formatDate(entry.data.pubDate)}
                            </time>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Featured Image -->
            {
                entry.data.image && (
                    <div class="featured-image">
                        <img
                            src={entry.data.image}
                            alt={entry.data.title}
                            class="featured-img"
                        />
                    </div>
                )
            }

            <!-- Article Content -->
            <div class="article-content">
                <Content />
            </div>

            <!-- Article Footer -->
            <footer class="article-footer">
                <div class="footer-content">
                    <!-- Share Section -->
                    <div class="share-section">
                        <p class="share-title">Share this article:</p>
                        <div class="share-buttons">
                            <a
                                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="share-button"
                                aria-label="Share on Twitter"
                            >
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                    ></path>
                                </svg>
                            </a>
                            <a
                                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="share-button"
                                aria-label="Share on Facebook"
                            >
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                                    ></path>
                                </svg>
                            </a>
                            <a
                                href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(entry.data.title)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="share-button"
                                aria-label="Share on Telegram"
                            >
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                                    ></path>
                                </svg>
                            </a>
                        </div>
                    </div>

                    <!-- Back to Blog -->
                    <a href="/blog" class="back-to-blog-button">
                        View More Articles
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                        </svg>
                    </a>
                </div>
            </footer>
        </div>
    </article>
</Layout>

<style>
    /* ============================================
     ARTICLE PAGE
     ============================================ */
    .article-page {
        background: var(--color-bg-primary);
        padding: calc(var(--spacing-section-y)) 0 var(--spacing-section-y);
        min-height: 100vh;
    }

    /* ============================================
     BACK BUTTON
     ============================================ */
    .back-button-wrapper {
        margin-bottom: 3rem;
        animation: fadeIn 0.8s ease-out;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-text-secondary);
        font-weight: 600;
        font-size: var(--font-size-base);
        text-decoration: none;
        transition: all var(--transition-base);
    }

    .back-button:hover {
        color: var(--color-orion);
        transform: translateX(-4px);
    }

    /* ============================================
     ARTICLE HEADER
     ============================================ */
    .article-header {
        max-width: 800px;
        margin: 0 auto 4rem;
        text-align: center;
        animation: fadeIn 1s ease-out 0.2s both;
    }

    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .tag {
        padding: 0.375rem 0.875rem;
        background: var(--color-bg-secondary);
        color: var(--color-text-secondary);
        border-radius: var(--radius-xl);
        font-size: var(--font-size-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .article-title {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
        color: var(--color-text-primary);
        margin: 0 0 1.5rem 0;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .article-description {
        font-size: clamp(1.125rem, 2.5vw, 1.5rem);
        color: var(--color-text-secondary);
        line-height: 1.7;
        margin: 0 0 2rem 0;
        font-weight: 400;
    }

    /* ============================================
     ARTICLE META
     ============================================ */
    .article-meta {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
    }

    .meta-author {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .author-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--color-bg-secondary);
        border: 2px solid var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
    }

    .author-avatar span {
        color: var(--color-orion);
        font-weight: 700;
        font-size: var(--font-size-lg);
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .author-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        text-align: left;
    }

    .author-name {
        font-size: var(--font-size-base);
        font-weight: 600;
        color: var(--color-text-primary);
        margin: 0;
    }

    .post-date {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
    }

    /* ============================================
     FEATURED IMAGE
     ============================================ */
    .featured-image {
        max-width: 1000px;
        margin: 0 auto 4rem;
        border-radius: var(--radius-2xl);
        overflow: hidden;
        box-shadow: var(--shadow-xl);
        animation: fadeIn 1s ease-out 0.4s both;
    }

    .featured-img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* ============================================
     ARTICLE CONTENT (Prose Styling)
     ============================================ */
    .article-content {
        max-width: 800px;
        margin: 0 auto 4rem;
        animation: fadeIn 1s ease-out 0.6s both;
    }

    /* Typography */
    .article-content :global(h1),
    .article-content :global(h2),
    .article-content :global(h3),
    .article-content :global(h4),
    .article-content :global(h5),
    .article-content :global(h6) {
        font-weight: 700;
        color: var(--color-text-primary);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        line-height: 1.3;
        letter-spacing: -0.02em;
    }

    .article-content :global(h1) {
        font-size: var(--font-size-4xl);
    }

    .article-content :global(h2) {
        font-size: var(--font-size-3xl);
    }

    .article-content :global(h3) {
        font-size: var(--font-size-2xl);
    }

    .article-content :global(h4) {
        font-size: var(--font-size-xl);
    }

    .article-content :global(p) {
        font-size: var(--font-size-lg);
        color: var(--color-text-secondary);
        line-height: 1.8;
        margin-bottom: 1.5rem;
    }

    .article-content :global(a) {
        color: var(--color-orion);
        text-decoration: underline;
        transition: color var(--transition-base);
    }

    .article-content :global(a:hover) {
        color: #4a5fd9;
    }

    .article-content :global(strong) {
        font-weight: 700;
        color: var(--color-text-primary);
    }

    .article-content :global(em) {
        font-style: italic;
    }

    /* Lists */
    .article-content :global(ul),
    .article-content :global(ol) {
        margin-bottom: 1.5rem;
        padding-left: 2rem;
        color: var(--color-text-secondary);
    }

    .article-content :global(li) {
        font-size: var(--font-size-lg);
        line-height: 1.8;
        margin-bottom: 0.75rem;
    }

    .article-content :global(ul li)::marker {
        color: var(--color-orion);
    }

    .article-content :global(ol li)::marker {
        color: var(--color-orion);
        font-weight: 700;
    }

    /* Checkbox list styling */
    .article-content :global(ul li:has(input[type="checkbox"])) {
        list-style-type: none;
        padding-left: 0;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .article-content :global(input[type="checkbox"]) {
        appearance: none;
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid var(--color-orion);
        border-radius: 4px;
        background: transparent;
        cursor: default;
        position: relative;
        top: 0.25rem;
        flex-shrink: 0;
    }

    .article-content :global(input[type="checkbox"]:checked) {
        background: var(--color-orion);
    }

    .article-content :global(input[type="checkbox"]:checked::after) {
        content: "";
        position: absolute;
        left: 6px;
        top: 2px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    /* Code */
    .article-content :global(code) {
        background: var(--color-bg-secondary);
        color: var(--color-orion);
        padding: 0.25rem 0.5rem;
        border-radius: var(--radius-md);
        font-size: 0.9em;
        font-family: "Courier New", monospace;
    }

    .article-content :global(pre) {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
    }

    .article-content :global(pre code) {
        background: none;
        padding: 0;
        color: var(--color-text-primary);
    }

    /* Blockquote */
    .article-content :global(blockquote) {
        border-left: 4px solid var(--color-orion);
        background: var(--color-bg-secondary);
        padding: 1.5rem 2rem;
        margin: 2rem 0;
        border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    }

    .article-content :global(blockquote p) {
        color: var(--color-text-primary);
        font-style: italic;
        margin-bottom: 0;
    }

    /* Images */
    .article-content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-md);
        margin: 2rem 0;
    }

    /* Horizontal Rule */
    .article-content :global(hr) {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
    }

    /* Tables */
    .article-content :global(table) {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 3rem 0;
        font-size: var(--font-size-base);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .article-content :global(th),
    .article-content :global(td) {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--color-border);
        text-align: left;
    }

    .article-content :global(tr:last-child td) {
        border-bottom: none;
    }

    .article-content :global(th) {
        background: var(--color-bg-secondary);
        font-weight: 700;
        color: var(--color-text-primary);
        font-size: var(--font-size-sm);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .article-content :global(td) {
        color: var(--color-text-secondary);
        background: var(--color-bg-primary);
    }

    .article-content :global(tbody tr:hover td) {
        background: var(--color-bg-secondary);
    }

    /* ============================================
     ARTICLE FOOTER
     ============================================ */
    .article-footer {
        max-width: 800px;
        margin: 0 auto;
        padding-top: 3rem;
        border-top: 1px solid var(--color-border);
        animation: fadeIn 1s ease-out 0.8s both;
    }

    .footer-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .footer-content {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    /* ============================================
     SHARE SECTION
     ============================================ */
    .share-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .share-title {
        font-size: var(--font-size-sm);
        font-weight: 600;
        color: var(--color-text-primary);
        margin: 0;
    }

    .share-buttons {
        display: flex;
        gap: 0.75rem;
    }

    .share-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--color-bg-secondary);
        color: var(--color-text-secondary);
        transition: all var(--transition-base);
    }

    .share-button:hover {
        background: var(--color-orion);
        color: white;
        transform: translateY(-2px);
    }

    /* ============================================
     BACK TO BLOG BUTTON
     ============================================ */
    .back-to-blog-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 2rem;
        background: var(--color-orion);
        color: white;
        border-radius: var(--radius-lg);
        font-weight: 600;
        font-size: var(--font-size-base);
        text-decoration: none;
        transition: all var(--transition-base);
        white-space: nowrap;
    }

    .back-to-blog-button:hover {
        background: #4a5fd9;
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    /* ============================================
     ANIMATIONS
     ============================================ */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ============================================
     RESPONSIVE
     ============================================ */
    @media (max-width: 768px) {
        .article-page {
            padding: calc(var(--spacing-section-y-mobile) + 72px) 0
                var(--spacing-section-y-mobile);
        }

        .back-button-wrapper {
            margin-bottom: 2rem;
        }

        .article-header {
            margin-bottom: 2rem;
        }

        .featured-image {
            margin-bottom: 2rem;
        }

        .article-content {
            margin-bottom: 2rem;
        }

        .article-footer {
            padding-top: 2rem;
        }
    }

    /* ============================================
     REDUCED MOTION
     ============================================ */
    @media (prefers-reduced-motion: reduce) {
        .back-button-wrapper,
        .article-header,
        .featured-image,
        .article-content,
        .article-footer {
            animation: none;
        }

        .back-button:hover,
        .share-button:hover,
        .back-to-blog-button:hover {
            transform: none;
        }
    }
</style>
